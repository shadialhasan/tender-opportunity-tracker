# Output path for extracted tender catalog
OUTPUT_PATH=tenders_report.json

# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Default Filter Criteria
DEFAULT_FILTER_CATEGORY=IT & Cloud Infrastructure
DEFAULT_FILTER_STATUS=OPEN

# Source Procurement API or Webhook (optional)
TENDER_PORTAL_URL=https://procurement.example.gov/api/v1/bids
